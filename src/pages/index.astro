---
import { Content as BioContent } from "../../BIO.md";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readBio } from "../lib/bio";
import { collectPosts } from "../lib/posts";

const [, posts] = await Promise.all([readBio(), collectPosts()]);
---

<BaseLayout title="schwarzkopfb/blog" home>
  <section class="bio" aria-label="About">
    <BioContent />
  </section>
  <ul class="post-index" aria-label="Posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.date}>{post.date}</time>
        <a href={post.route}>{post.title}</a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .bio {
    max-width: 38rem;
    margin-bottom: clamp(4rem, 10vw, 6.5rem);
    font-size: clamp(1.12rem, 3vw, 1.3rem);
    line-height: 1.65;
  }

  .bio :global(p) {
    margin: 0;
  }

  .bio :global(p + p) {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.78em;
  }

  .bio :global(a) {
    color: inherit;
    text-decoration-color: var(--line);
  }

  .bio :global(a:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .post-index {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
  }

  time {
    color: var(--muted);
    font: 0.79rem/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.025em;
  }

  a {
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 520;
    line-height: 1.45;
    text-decoration-color: var(--line);
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 34rem) {
    .post-index {
      gap: 1.4rem;
    }

    li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
