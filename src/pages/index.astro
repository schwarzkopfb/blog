---
import { Content as BioContent } from "../../BIO.md";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readBio } from "../lib/bio";
import { collectPosts, groupPosts } from "../lib/posts";

const [, posts] = await Promise.all([readBio(), collectPosts()]);
const postGroups = groupPosts(posts);
---

<BaseLayout title="schwarzkopfb/blog" home>
  <section class="bio" aria-label="About">
    <BioContent />
  </section>
  <ul class="post-index" aria-label="Posts">
    {postGroups.map(({ canonical, variants }) => (
      <li>
        <time datetime={canonical.date}>{canonical.date}</time>
        <span class="post-entry">
          <a class="post-title" href={canonical.route}>{canonical.title}</a>
          {variants.length > 0 && (
            <span class="post-variants" aria-label="Available variants">
              <span aria-hidden="true"> [</span>
              {variants.map((variant, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">, </span>}
                  <a href={variant.route}>{variant.variant!.toUpperCase()}</a>
                </>
              ))}
              <span aria-hidden="true">]</span>
            </span>
          )}
        </span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .bio {
    max-width: 38rem;
    margin-bottom: clamp(4rem, 10vw, 6.5rem);
    font-size: clamp(1.12rem, 3vw, 1.3rem);
    line-height: 1.65;
  }

  .bio :global(p) {
    margin: 0;
  }

  .bio :global(p + p) {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.78em;
  }

  .bio :global(a) {
    color: inherit;
    text-decoration-color: var(--line);
  }

  .bio :global(a:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .post-index {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 6.75rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
  }

  time {
    color: var(--muted);
    font: 0.79rem/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.025em;
  }

  .post-entry {
    line-height: 1.45;
  }

  .post-entry a {
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 520;
    text-decoration-color: var(--line);
  }

  .post-entry a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .post-variants {
    color: var(--muted);
    white-space: nowrap;
  }

  .post-variants a {
    color: var(--muted);
    font: 600 0.72rem/1.45 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.06em;
  }

  @media (max-width: 34rem) {
    .post-index {
      gap: 1.4rem;
    }

    li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
