---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectPosts, getPostNeighbors, groupPosts, type Post } from "../lib/posts";

type Props = {
  post: Post;
  entry: CollectionEntry<"posts">;
  previous: Post | null;
  next: Post | null;
  versions: Post[];
};

export async function getStaticPaths() {
  const [posts, entries] = await Promise.all([collectPosts(), getCollection("posts")]);
  const entriesById = new Map(entries.map((entry) => [entry.id, entry]));
  const postIds = new Set(posts.map((post) => post.id));
  const postGroups = groupPosts(posts);
  const canonicalPosts = postGroups.map((group) => group.canonical);
  const groupsByCanonicalId = new Map(
    postGroups.map((group) => [group.canonical.id, group]),
  );
  const missingEntries = posts.filter((post) => !entriesById.has(post.id));
  const unexpectedEntries = entries.filter((entry) => !postIds.has(entry.id));

  if (missingEntries.length > 0 || unexpectedEntries.length > 0) {
    const details = [
      ...missingEntries.map((post) => `Missing Astro content entry for ${post.sourcePath}.`),
      ...unexpectedEntries.map((entry) => `Unexpected Astro content entry ${entry.id}.`),
    ];
    throw new Error(`Post discovery mismatch:\n${details.join("\n")}`);
  }

  return posts.map((post) => {
    const group = groupsByCanonicalId.get(post.canonicalId)!;
    const { previous, next } = getPostNeighbors(canonicalPosts, post.canonicalId);
    return {
      params: { slug: post.id },
      props: {
        post,
        entry: entriesById.get(post.id)!,
        previous,
        next,
        versions: [group.canonical, ...group.variants],
      },
    };
  });
}

const { post, entry, previous, next, versions } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${post.title} · schwarzkopfb/blog`} showAllPosts>
  <p class="post-path">{post.pathLabel}</p>
  <h1 class:list={["post-heading", { "post-heading--with-variants": versions.length > 1 }]}>
    {post.title}
  </h1>
  {versions.length > 1 && (
    <nav class="post-variants" aria-label="Post versions">
      {versions.map((version) => (
        <a
          href={version.route}
          aria-current={version.id === post.id ? "page" : undefined}
        >
          {version.variant?.toUpperCase() ?? "EN"}
        </a>
      ))}
    </nav>
  )}
  <article>
    <Content />
  </article>
  {(previous || next) && (
    <nav class="post-navigation" aria-label="Post chronology">
      {previous && (
        <a
          class="post-navigation__link post-navigation__link--previous"
          href={previous.route}
          rel="prev"
          aria-label={`Previous post: ${previous.title}`}
          title={previous.title}
        >
          <span class="post-navigation__arrow" aria-hidden="true">←</span>
          <span class="post-navigation__title">{previous.title}</span>
          <span class="post-navigation__label" aria-hidden="true">PREV</span>
        </a>
      )}
      {next && (
        <a
          class="post-navigation__link post-navigation__link--next"
          href={next.route}
          rel="next"
          aria-label={`Next post: ${next.title}`}
          title={next.title}
        >
          <span class="post-navigation__title">{next.title}</span>
          <span class="post-navigation__arrow" aria-hidden="true">→</span>
          <span class="post-navigation__label" aria-hidden="true">NEXT</span>
        </a>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .post-heading--with-variants {
    margin-bottom: 1.1rem;
  }

  .post-variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 2.4rem;
    font: 500 0.72rem/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .post-variants a {
    padding: 0.4rem 0.78rem;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .post-variants a:hover {
    color: var(--text);
  }

  .post-variants a[aria-current="page"] {
    color: var(--background);
    background: var(--text);
  }

  article > :global(h1:first-child) {
    display: none;
  }

  .post-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 6vw, 4rem);
    margin-top: clamp(5rem, 12vw, 8rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }

  .post-navigation__link {
    display: grid;
    align-items: baseline;
    column-gap: 0.65rem;
    min-width: 0;
    max-width: 100%;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.5;
    text-decoration-color: transparent;
    opacity: 0.62;
    transition: color 160ms ease, opacity 160ms ease, text-decoration-color 160ms ease;
  }

  .post-navigation__link:hover,
  .post-navigation__link:focus-visible {
    color: var(--text);
    text-decoration-color: currentColor;
    opacity: 1;
  }

  .post-navigation__link--previous {
    grid-column: 1;
    grid-template-columns: auto minmax(0, 1fr);
    justify-self: start;
  }

  .post-navigation__link--next {
    grid-column: 2;
    grid-template-columns: minmax(0, 1fr) auto;
    justify-self: end;
    text-align: right;
  }

  .post-navigation__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-navigation__arrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .post-navigation__link--previous .post-navigation__arrow {
    grid-column: 1;
    grid-row: 1;
  }

  .post-navigation__link--previous .post-navigation__title {
    grid-column: 2;
    grid-row: 1;
  }

  .post-navigation__link--next .post-navigation__title {
    grid-column: 1;
    grid-row: 1;
  }

  .post-navigation__link--next .post-navigation__arrow {
    grid-column: 2;
    grid-row: 1;
  }

  .post-navigation__label {
    grid-row: 2;
    margin-top: 0.28rem;
    font: 500 0.66rem/1.3 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.1em;
  }

  .post-navigation__link--previous .post-navigation__label {
    grid-column: 2;
    justify-self: start;
  }

  .post-navigation__link--next .post-navigation__label {
    grid-column: 1;
    justify-self: end;
  }

  @media (max-width: 34rem) {
    .post-navigation {
      gap: 1.25rem;
      margin-top: 4.5rem;
    }

    .post-navigation__link {
      font-size: 0.8rem;
    }
  }
</style>
